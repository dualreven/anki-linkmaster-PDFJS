{
  "name": "anki-linkmaster-pdfjs",
  "version": "1.0.0",
  "description": "Anki LinkMaster PDFJS - PDF management and viewer application",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/only-allow.js",
    "dev": "vite",
    "build": "vite build",
    "build:pdf-home": "node scripts/build-only.mjs home",
    "build:pdf-viewer": "node scripts/build-only.mjs viewer",
    "build:all": "node scripts/build-only.mjs home && node scripts/build-only.mjs viewer",
    "preview": "vite preview",
    "test": "jest",
    "test:smoke": "jest --runTestsByPath src/frontend/pdf-viewer/__smoke__/annotation-card-jump.smoke.test.js src/frontend/pdf-viewer/__smoke__/anchor-create.smoke.test.js -i",
    "test:impact": "node -e \"process.exitCode=0\" && node scripts/impact/changed-tests.mjs --run",
    "test:watch": "jest --watch",
    "benchmark": "node AItemp/performance-benchmark.js",
    "check:deps": "depcruise --config src/frontend/pdf-viewer/.dependency-cruiser.cjs src/frontend/pdf-viewer",
    "test:pre-commit": "pnpm run check:deps && pnpm run test",
    "test:format": "node scripts/test-formatting.mjs",
    "lint:memory-bank": "node scripts/ci/memory-bank-limit.js --fix",
    "lint": "pnpm -s run lint:memory-bank && pnpm exec eslint src scripts eslint-rules --ext .js,.cjs,.mjs",
    "lint:strict:pdf-core": "pnpm exec eslint src/frontend/pdf-viewer/pdf --ext .js",
    "lint:strict:common-core": "pnpm exec eslint src/frontend/common --ext .js",
    "lint:strict:pdf-home-search-filter": "pnpm exec eslint src/frontend/pdf-home/features/search src/frontend/pdf-home/features/filter --ext .js",
    "lint:strict:pdf-home-sr-sidebar": "pnpm exec eslint src/frontend/pdf-home/features/search-results src/frontend/pdf-home/features/sidebar --ext .js",
    "lint:features": "pnpm exec eslint src/frontend/pdf-viewer/features src/frontend/pdf-home/features --ext .js",
    "lint:features:ci": "pnpm exec eslint src/frontend/pdf-home/features/search src/frontend/pdf-home/features/search-results src/frontend/pdf-home/features/search-result-item src/frontend/pdf-home/features/filter src/frontend/pdf-home/features/pdf-edit --ext .js --ignore-pattern \"**/__tests__/**\"",
    "format:check": "node scripts/run-prettier.mjs --check",
    "format": "node scripts/run-prettier.mjs --write",
    "lint:fix": "pnpm exec eslint src scripts eslint-rules --ext .js,.cjs,.mjs --fix",
    "legacy:e2e:browser": "echo \"[deprecated] legacy browser e2e\" && playwright test -c ./playwright.config.js",
    "integ:frontend:pdf-home:add-pdf": "playwright test -c ./playwright.integ.config.js tests/e2e/browser/pdf-home/add-pdf.spec.mjs",
    "integ:protocol:pdf-home:add-pdf:relay": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/msgcenter/test_pdf_home_add_pdf_relay.py",
    "integ:backend:pdf-home:add-pdf:db-assert": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/backend/test_pdf_home_add_pdf_db_assert.py",
    "ct:ws:pdf-home:add-pdf": "pnpm exec jest --config jest.config.js --runTestsByPath tests/e2e/node/pdf-home/add-pdf.contract.test.js --testPathIgnorePatterns a^ -i",
    "integ:frontend:pdf-home:add-pdf:confirm": "pnpm exec jest --runTestsByPath tests/e2e/node/pdf-home/add-pdf.confirm.test.js --testPathIgnorePatterns='a^' -i",
    "e2e:flow:pdf-home:add-pdf": "pnpm -s integ:frontend:pdf-home:add-pdf && pnpm -s integ:protocol:pdf-home:add-pdf:relay && pnpm -s integ:backend:pdf-home:add-pdf:db-assert && node tests/e2e/runner/confirm-artifact.mjs && node tests/e2e/runner/contract-check.mjs",
    "e2e:flow:pdf-home:all": "node tests/e2e/runner/run-flows.mjs --flows pdf-home/* --config tests/e2e/config/local.json --dry-run",
    "e2e:flow:all": "node tests/e2e/runner/run-flows.mjs --config tests/e2e/config/local.json --dry-run",
    "integ:frontend:pdf-viewer:outline-create:F1": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/outline-create.F1.test.js",
    "integ:backend:pdf-viewer:outline-create:P0": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/backend/test_outline_prereq_pdf_record.py",
    "integ:protocol:pdf-viewer:outline-create:N2": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/msgcenter/test_pdf_viewer_outline_create_relay.py",
    "integ:backend:pdf-viewer:outline-create:B1": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/backend/test_pdf_viewer_outline_create_db_assert.py",
    "integ:frontend:pdf-viewer:outline-create:F3": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/outline-create.F3.test.js",
    "integ:frontend:pdf-viewer:outline-navigate:F1": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/ws-outline-navigate.F1.inbound-map.test.js",
    "integ:frontend:pdf-viewer:outline-navigate:F2": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/ws-outline-navigate.F2.pending-to-success.test.js",
    "integ:frontend:pdf-viewer:outline-navigate:F2:ready": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/ws-outline-navigate.F2.list-ready-success.test.js",
    "integ:frontend:pdf-viewer:outline-navigate:F2:not-found": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/ws-outline-navigate.F2.not-found-failed.test.js",
    "integ:protocol:pdf-viewer:outline-navigate:N1": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/msgcenter/test_ws_outline_navigate_forward.py",
    "integ:protocol:pdf-viewer:outline-navigate:N1:failed": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/msgcenter/test_ws_outline_navigate_forward_failed.py",
    "integ:frontend:pdf-viewer:navigate:click:F1": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/outline-click-navigate.F1.emit.test.js",
    "integ:frontend:pdf-viewer:outline-init-import": "node tests/e2e/runner/run-with-vite.mjs",
    "integ:backend:pdf-viewer:outline-init-import:db-assert": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/backend/test_pdf_viewer_outline_init_db_assert.py",
    "integ:frontend:pdf-viewer:outline:init:list-null": "pnpm exec jest --config jest.config.js --runTestsByPath tests/integ/frontend/pdf-viewer/outline/01-init-list-null.test.js -i",
    "integ:frontend:pdf-viewer:outline:init:bulk-save": "pnpm exec jest --config jest.config.js --runTestsByPath tests/integ/frontend/pdf-viewer/outline/02-init-bulk-save.test.js -i",
    "integ:frontend:pdf-viewer:outline:init:second-list": "pnpm exec jest --config jest.config.js --runTestsByPath tests/integ/frontend/pdf-viewer/outline/03-init-second-list.test.js -i",
    "integ:frontend:pdf-viewer:outline:init:all": "pnpm -s integ:frontend:pdf-viewer:outline:init:list-null && pnpm -s integ:frontend:pdf-viewer:outline:init:bulk-save && pnpm -s integ:frontend:pdf-viewer:outline:init:second-list",
    "integ:frontend:pdf-viewer:outline:init:F1": "node tests/integ/frontend/pdf-viewer/outline/F1-list-null.mjs",
    "integ:protocol:pdf-viewer:outline:init:B2": "node tests/e2e/runner/run-py-step.mjs tests/integ/python/msgcenter/test_outline_init_relay_list.py",
    "integ:frontend:pdf-viewer:outline:init:F3": "node tests/integ/frontend/pdf-viewer/outline/F3-bulk-save.mjs",
    "integ:protocol:pdf-viewer:outline:init:B4": "node tests/e2e/runner/run-py-step.mjs tests/integ/python/msgcenter/test_outline_init_relay_bulk_save.py",
    "integ:frontend:pdf-viewer:outline:init:F5": "node tests/integ/frontend/pdf-viewer/outline/F5-render.mjs",
    "integ:flow:pdf-viewer:outline:init": "pnpm -s integ:frontend:pdf-viewer:outline:init:F1 && pnpm -s integ:protocol:pdf-viewer:outline:init:B2 && pnpm -s integ:frontend:pdf-viewer:outline:init:F3 && pnpm -s integ:protocol:pdf-viewer:outline:init:B4 && pnpm -s integ:frontend:pdf-viewer:outline:init:F5",
    "integ:frontend:pdf-viewer:outline:update:F1": "node tests/integ/frontend/pdf-viewer/outline/update/F1-update-request.mjs",
    "integ:protocol:pdf-viewer:outline:update:B2": "node tests/e2e/runner/run-py-step.mjs tests/integ/python/msgcenter/test_outline_update_relay_update.py",
    "integ:frontend:pdf-viewer:outline:update:F3": "node tests/integ/frontend/pdf-viewer/outline/update/F3-list-request.mjs",
    "integ:protocol:pdf-viewer:outline:update:B4": "node tests/e2e/runner/run-py-step.mjs tests/integ/python/msgcenter/test_outline_update_relay_list_after_update.py",
    "integ:frontend:pdf-viewer:outline:update:F5": "node tests/integ/frontend/pdf-viewer/outline/update/F5-render.mjs",
    "integ:flow:pdf-viewer:outline:update": "pnpm -s integ:frontend:pdf-viewer:outline:update:F1 && pnpm -s integ:protocol:pdf-viewer:outline:update:B2 && pnpm -s integ:frontend:pdf-viewer:outline:update:F3 && pnpm -s integ:protocol:pdf-viewer:outline:update:B4 && pnpm -s integ:frontend:pdf-viewer:outline:update:F5",
    "e2e:flow:pdf-viewer:outline-create": "pnpm -s integ:backend:pdf-viewer:outline-create:P0 && pnpm -s integ:frontend:pdf-viewer:outline-create:F1 && pnpm -s integ:protocol:pdf-viewer:outline-create:N2 && pnpm -s integ:frontend:pdf-viewer:outline-create:F3 && pnpm -s integ:backend:pdf-viewer:outline-create:B1",
    "e2e:flow:pdf-viewer:outline-navigate": "pnpm -s integ:protocol:pdf-viewer:outline-navigate:N1 && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F1 && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2",
    "e2e:flow:pdf-viewer:navigate:ws:all": "pnpm -s integ:protocol:pdf-viewer:outline-navigate:N1 && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F1 && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2 && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2:ready && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2:not-found && pnpm -s integ:protocol:pdf-viewer:outline-navigate:N1:failed && pnpm -s integ:viewer:outline-navigate:log-assert",
    "e2e:flow:pdf-viewer:navigate:url:all": "pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2 && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2:ready && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2:not-found",
    "e2e:flow:pdf-viewer:navigate:click:all": "pnpm -s integ:frontend:pdf-viewer:navigate:click:F1 && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2 && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2:ready && pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2:not-found",
    "integ:viewer:outline-navigate:log-assert": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/viewer/test_viewer_outline_navigate_log_confirm.py",
    "ct:ws:pdf-viewer:outline-navigate": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/ws-outline-navigate.contract.test.js",
    "integ:protocol:pdf-viewer:navigate:ws:N1": "pnpm -s integ:protocol:pdf-viewer:outline-navigate:N1",
    "integ:frontend:pdf-viewer:navigate:ws:F1": "pnpm -s integ:frontend:pdf-viewer:outline-navigate:F1",
    "integ:frontend:pdf-viewer:navigate:ws:F2": "pnpm -s integ:frontend:pdf-viewer:outline-navigate:F2",
    "e2e:flow:pdf-viewer:navigate:ws": "pnpm -s e2e:flow:pdf-viewer:outline-navigate",
    "e2e:flow:pdf-viewer:outline-init-import": "pnpm -s integ:frontend:pdf-viewer:outline-init-import && pnpm -s integ:backend:pdf-viewer:outline-init-import:db-assert",
    "integ:frontend:pdf-viewer:client-register:F1": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/client-register.F1.test.js",
    "integ:protocol:pdf-viewer:client-register:B2": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/msgcenter/test_client_register_relay.py",
    "integ:frontend:pdf-viewer:client-register:F3": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/client-register.F3.test.js",
    "ct:ws:pdf-viewer:client-register": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-viewer/client-register.contract.test.js",
    "e2e:flow:pdf-viewer:client-register": "pnpm -s integ:frontend:pdf-viewer:client-register:F1 && pnpm -s integ:protocol:pdf-viewer:client-register:B2 && pnpm -s integ:frontend:pdf-viewer:client-register:F3 && pnpm -s ct:ws:pdf-viewer:client-register",
    "integ:frontend:pdf-home:client-register:F1": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-home/client-register.F1.test.js",
    "integ:protocol:pdf-home:client-register:B2": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/msgcenter/test_pdf_home_client_register_relay.py",
    "integ:frontend:pdf-home:client-register:F3": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-home/client-register.F3.test.js",
    "ct:ws:pdf-home:client-register": "node tests/e2e/runner/run-jest-step.mjs tests/e2e/node/pdf-home/client-register.contract.test.js",
    "e2e:flow:pdf-home:client-register": "pnpm -s integ:frontend:pdf-home:client-register:F1 && pnpm -s integ:protocol:pdf-home:client-register:B2 && pnpm -s integ:frontend:pdf-home:client-register:F3 && pnpm -s ct:ws:pdf-home:client-register",
    "integ:python:gui-launcher:client-register:F1": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/gui_launcher/test_client_register_F1.py",
    "integ:protocol:gui-launcher:client-register:B2": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/msgcenter/test_gui_launcher_client_register_relay.py",
    "integ:python:gui-launcher:client-register:F3": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/gui_launcher/test_client_register_F3.py",
    "ct:python:gui-launcher:client-register": "node tests/e2e/runner/run-py-step.mjs tests/e2e/python/gui_launcher/test_client_register_contract.py",
    "e2e:flow:gui-launcher:client-register": "pnpm -s integ:python:gui-launcher:client-register:F1 && pnpm -s integ:protocol:gui-launcher:client-register:B2 && pnpm -s integ:python:gui-launcher:client-register:F3 && pnpm -s ct:python:gui-launcher:client-register",
    "e2e:flow:all:client-register": "pnpm -s e2e:flow:pdf-viewer:client-register && pnpm -s e2e:flow:pdf-home:client-register && pnpm -s e2e:flow:gui-launcher:client-register",
    "ci:ws-types-diff": "node scripts/ci/ws-contract-diff.mjs",
    "ci:memory-bank-limit": "node scripts/ci/memory-bank-limit.js",
    "ci:frontend-line-limit": "node scripts/ci/frontend-line-limit.js",
    "ci:frontend-line-limit:write-baseline": "node scripts/ci/frontend-line-limit.js --write-baseline",
    "docs:frontend": "jsdoc -c jsdoc.config.cjs"
  },
  "engines": {
    "node": ">=14.0.0",
    "pnpm": ">=7.0.0"
  },
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@babel/core": "^7.22.0",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "@babel/plugin-proposal-private-methods": "^7.18.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "babel-plugin-transform-import-meta": "^2.2.1",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.1",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/preset-env": "^7.22.0",
    "eslint": "^9.34.0",
    "jest": "^30.1.1",
    "jest-environment-jsdom": "^30.1.1",
    "vite": "^5.0.0",
    "vite-plugin-babel": "^1.3.2",
    "dependency-cruiser": "17.3.6",
    "fake-indexeddb": "6.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1",
    "@eslint/js": "^9.14.0",
    "globals": "^15.12.0",
    "eslint-plugin-jsdoc": "^48.2.12",
    "prettier": "^3.4.2",
    "@playwright/test": "^1.48.2",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "core-js": "^3.45.1",
    "izitoast": "^1.4.0",
    "jquery": "^3.7.1",
    "jstree": "^3.3.17",
    "pdfjs-dist": "^4.7.76",
    "regenerator-runtime": "^0.14.1"
  }
}
