# Keep line endings stable across platforms (project rule: UTF-8 + \n).
* text=auto eol=lf

# Windows cmd/bat scripts typically require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
